6.1902,6.11769,6.03554,5.96379,5.91366,5.88657,5.89354,5.93019,5.99442,6.0799,6.1755,6.27195,6.35735,6.42225,6.45975,6.46508,6.43768,6.38036,6.29972,6.20515,6.10743,6.01787,5.94662,5.90142,5.88662,5.90271,5.94636,6.01077,6.08647,6.16267,6.22869,6.27517,6.29496,6.28383,6.24108],"pl":[6.72992,6.6485,6.78483,6.77863,6.7318,6.81235,6.76712,6.79919,6.80315,6.79095,6.80708,6.79159,6.79306,6.78911,6.78188,6.78343,6.77993,6.78282,6.78715,6.79283,6.8022,6.81154,6.82283,6.83328,6.8424,6.85,6.85475,6.85725,6.85729,6.85541,6.85252,6.84926,6.84671,6.84562,6.84661,6.85011,6.85614,6.86446,6.87455,6.88563,6.89683,6.9072,6.91588,6.9222,6.9257,6.92625,6.92406,6.91961,6.91363,6.90701,6.90065,6.89541,6.89194,6.89064,6.89161,6.89463,6.89919,6.90457,6.90993,6.91437,6.91708],"p_d":3.9999888990872274,"pi_source":"checkpoints, 61 samples","q_source":"checkpoints, 61 samples","summary":"P 6.65/6.93 mmHg   pulse 0.28   Q̄ 5.94 mL/s","exact":true,"params":{"R_p":31.964,"R_d":607.316,"C":0.001399601,"P_d":5332.88,"p0":8976.776}}],"has_windkessel":true,"stabilization":[{"group":"Fluid","name":"Streamline diffusion (SUPG/SD)","value":"on  ·  parameter=standard  length_scale=metric  parameter_element_constant=on","detail":"Adds artificial diffusion along the streamlines to damp the spurious oscillations Galerkin advection produces at high cell Péclet number. 'length_scale: metric' sizes it from the element metric rather than a scalar diameter, which matters on the stretched cells an ALE mesh develops.","active":true},{"group":"Fluid","name":"Backflow stabilization","value":"boundaries [4, 5]","detail":"Penalises inflow through an outlet. Without it, reverse flow over part of an outlet cap during diastole feeds unbounded kinetic energy back into the domain and the solve diverges — the classic open-outlet instability.","active":true},{"group":"Fluid","name":"Forced-normal flow","value":"off","detail":"Constrains the velocity at a boundary to stay parallel to the face normal, suppressing in-plane drift at inlets and outlets.","active":false},{"group":"Fluid","name":"Pressure fixing","value":"off","detail":"Pins the pressure at one point to remove the constant null space. Not needed when an outlet prescribes pressure — a Windkessel does, which is why it is off here.","active":false},{"group":"Fluid","name":"Velocity–pressure coupling","value":"fractionalstep  ·  scheme=CT  coupled_velocity=off  robin_bc_velocity_scheme=implicit","detail":"A fractional-step (projection) scheme splits the saddle-point system into a tentative-velocity solve, a pressure Poisson solve and a correction — cheap, at the cost of a splitting error at the boundary.","active":true},{"group":"Fluid","name":"Windkessel treatment","value":"implicit=on  condensed=on","detail":"Implicit coupling folds the 0-D outlet into the pressure operator as a low-rank correction instead of lagging it as an explicit Dirichlet value, which is what makes a compliant outlet stable at physiological R and C. 'condensed' holds the pressure constant over each outlet by condensing its DOFs.","active":true},{"group":"Fluid","name":"Windkessel tangent penalty","value":"off","detail":"Penalises tangential velocity on the Windkessel outlets.","active":false},{"group":"Mesh (ALE)","name":"Lifting operator","value":"elastic_element  ·  mu=1","detail":"Extends the interface displacement into the fluid mesh. An elastic-element operator stiffens small cells so the boundary layer is carried along rigidly and elements near the wall do not invert under large wall motion.","active":true},{"group":"Solid","name":"Kelvin–Voigt viscoelasticity","value":"η = 10","detail":"Physical rate-dependent damping in the wall. It also damps the high-frequency ringing an FSI interface excites, so it doubles as a stabiliser of the coupled iteration.","active":true},{"group":"Solid","name":"Incompressibility","value":"penalty simo_miehe  κ=1e+08","detail":"A penalty enforces near-incompressibility without a pressure unknown; κ sets how hard. Too large locks a low-order element, too small lets the wall change volume — the trade-off the penalty_parameter comment in the yaml is about.","active":true},{"group":"Solid","name":"Augmented Lagrange","value":"off","detail":"Iteratively corrects the penalty so the volume constraint is met without driving κ up.","active":false},{"group":"Solid","name":"Time integration","value":"generalized_alpha  ·  alpha_f=0.5  alpha_m=0.5  beta=0.25  gamma=0.5  stress_scheme=midpoint","detail":"Generalised-α evaluates the residual at intermediate points so high-frequency modes are damped while second-order accuracy is kept; α_m and α_f set how much. β and γ are the Newmark parameters. NOTE the mapping from α to the high-frequency dissipation ρ∞ differs between conventions, so read these against the solver's own definition before concluding how dissipative the scheme is.","active":true},{"group":"Solid","name":"Newton line search","value":"bt","detail":"Backtracking ('bt') shortens a Newton step that would increase the residual — what keeps a clamped, prestressed wall from inverting elements on the first iteration.","active":true},{"group":"Solid","name":"Quadrature degree","value":"6","detail":"Integration order for the constitutive terms. Under-integration is itself a (risky) stabilisation; over-integration costs time.","active":true},{"group":"Coupling","name":"FSI scheme","value":"newton-snes","detail":"How the fluid and solid subproblems are advanced together. A monolithic/Newton scheme avoids the added-mass instability that breaks loosely coupled schemes when the fluid and wall densities are comparable — as they are for blood and tissue.","active":true},{"group":"Coupling","name":"Interface relaxation","value":"iqn-ils  ·  max_history=30  rcond=1e-06  reuse_steps=2  step_cap=3  omega_init=0.1","detail":"IQN-ILS builds a quasi-Newton approximation from the history of interface residuals, which is what makes the fixed-point iteration converge at all under strong added mass. max_history and reuse_steps set how much history is kept.","active":true},{"group":"Coupling","name":"Traction relaxation","value":"0.5","detail":"Under-relaxes the traction handed to the solid; damps the first coupling iterations.","active":true},{"group":"Coupling","name":"Lumped traction transfer","value":"on","detail":"Transfers the interface traction through a lumped (diagonal) mass matrix, avoiding the checkerboarding a consistent transfer can produce.","active":true},{"group":"Coupling","name":"Coupling tolerance","value":"0.0001","detail":"Residual at which the interface iteration is declared converged.","active":true},{"group":"Coupling","name":"Max coupling iterations","value":"60","detail":"Cap on the interface iteration per time step.","active":true},{"group":"Coupling","name":"Interface predictor","value":"linear","detail":"Extrapolates the interface position at the start of each step so the iteration starts closer to the solution.","active":true},{"group":"Prestress","name":"MULF prestress","value":"p = 9239.2 dyn/cm²  (6.9 mmHg)  ·  20 load steps","detail":"Finds the prestretch that holds the imaged (already loaded) geometry in equilibrium, so the wall is not step-loaded at t=0.","active":true},{"group":"Prestress","name":"Robin support in prestress","value":"on","detail":"Includes the Robin springs in the prestress residual. It vanishes at u=0 so the fixed point is unchanged, but without it a wall with free ends takes a first Newton step of order the vessel radius and the elements invert.","active":true},{"group":"Prestress","name":"Prestress line search","value":"basic","detail":"Newton globalisation during the prestress load ramp.","active":true}],"assimilation":[],"parameters":[],"camera":null,"frame":{"center":[19.459662173499645,21.551766581458917,36.77482373857222],"x":[-0.3948938995858052,-0.3985394723592045,0.8277832427885717],"y":[-0.07259454517291702,-0.8846584269317805,-0.46055347102125477],"z":[0.9158541587398366,-0.24196230415136,0.320414424